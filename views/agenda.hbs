<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clínica Dental - Gestión de Citas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-primary shadow-sm mb-4">
        <div class="container">
            <span class="navbar-brand fw-bold"><i class="bi bi-shield-plus"></i> PANEL DENTAL</span>
            <div class="d-flex align-items-center">
                <span id="display-user" class="text-white me-3"></span>
                <button class="btn btn-outline-light btn-sm" onclick="salir()">Cerrar Sesión</button>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="btn-group">
                <button id="btn-citas" class="btn btn-primary active" onclick="cambiarVista('citas')">Agenda Diaria</button>
                <button id="btn-historial" class="btn btn-outline-primary" onclick="cambiarVista('historial')">Historial Clínico</button>
            </div>
            <button class="btn btn-success fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevaCita">
                <i class="bi bi-plus-circle"></i> AGREGAR PACIENTE
            </button>
        </div>

        <div id="seccionCitas">
            <div id="contenedorCitas" class="row g-3">
                </div>
        </div>

        <div id="seccionHistorial" style="display: none;">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 250px;">Paciente / Adjunto</th>
                                <th>Diagnóstico</th>
                                <th>Cobro</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody id="tablaHistorial">
                            </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalNuevaCita" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Agendar Paciente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="fw-bold small">Nombre del Paciente:</label>
                    <input type="text" id="new_paciente" class="form-control mb-3" placeholder="Juan Pérez">
                    
                    <label class="fw-bold small">Motivo Consulta:</label>
                    <textarea id="new_motivo" class="form-control mb-3" rows="2"></textarea>
                    
                    <div class="row">
                        <div class="col-6">
                            <label class="fw-bold small">Fecha:</label>
                            <input type="date" id="new_fecha" class="form-control">
                        </div>
                        <div class="col-6">
                            <label class="fw-bold small">Hora:</label>
                            <input type="time" id="new_hora" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success w-100" onclick="guardarNuevaCita()">GUARDAR EN AGENDA</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAtender" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Finalizar Atención</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="at_id">
                    <label class="fw-bold small">Diagnóstico Médico:</label>
                    <textarea id="at_diag" class="form-control mb-3" rows="3"></textarea>
                    
                    <label class="fw-bold small">Monto Cobrado ($):</label>
                    <input type="number" id="at_monto" class="form-control mb-3">

                    <label class="fw-bold small">Subir Radiografía / Ficha (Imagen):</label>
                    <input type="file" id="at_foto" class="form-control" accept="image/*">
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary w-100" onclick="confirmarAtencion()">GUARDAR EN HISTORIAL</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditar" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Modificar Cita</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="edit_id">
                    <label class="fw-bold small">Paciente:</label>
                    <input type="text" id="edit_paciente" class="form-control mb-3" readonly>
                    <label class="fw-bold small">Nuevo Motivo:</label>
                    <textarea id="edit_motivo" class="form-control mb-3"></textarea>
                    <div class="row">
                        <div class="col-6"><input type="date" id="edit_fecha" class="form-control"></div>
                        <div class="col-6"><input type="time" id="edit_hora" class="form-control"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-warning w-100" onclick="guardarEdicion()">ACTUALIZAR DATOS</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/aplicacion.js"></script>
</body>
</html>