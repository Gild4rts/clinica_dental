<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Clínica Dental - Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background-color: #0a192f; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .login-box { background: #ccd6f6; padding: 40px; border-radius: 20px; width: 100%; max-width: 450px; text-align: center; }
        .btn-login { background-color: #0a4da2; color: white; font-weight: bold; }
    </style>
</head>
<body>
    <div class="login-box">
        <i class="bi bi-capsule-pill" style="font-size: 3rem; color: #000;"></i>
        <h1 class="fw-bold mt-2" style="color: #0a4da2;">Acceso Clínico</h1>
        <p class="text-muted">Ingrese sus credenciales para gestionar la agenda</p>

        <form onsubmit="ejecutarLogin(event)">
            <div class="mb-3 text-start">
                <label class="form-label fw-bold text-primary">USUARIO</label>
                <input type="text" id="usuario" class="form-control" placeholder="admin" required>
            </div>
            <div class="mb-3 text-start">
                <label class="form-label fw-bold text-primary">CONTRASEÑA</label>
                <input type="password" id="contrasena" class="form-control" placeholder="••••" required>
            </div>
            <button type="submit" class="btn btn-login w-100 p-2">Iniciar Sesión</button>
        </form>
        <p class="mt-4 text-muted small">Sistema de Gestión Interna v2.0</p>
    </div>
    <script src="/aplicacion.js"></script>
</body>
</html>