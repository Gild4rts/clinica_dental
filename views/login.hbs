<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acceso Clínica Dental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #1a1a2e; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; color: white; font-family: 'Segoe UI', sans-serif; }
        .login-card { background: #16213e; padding: 2.5rem; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); width: 100%; max-width: 400px; }
        .form-control { background: #0f3460; border: 1px solid #1a1a2e; color: white; }
        .form-control:focus { background: #0f3460; color: white; border-color: #00d2ff; box-shadow: none; }
        .btn-primary { background: #00d2ff; border: none; color: #1a1a2e; font-weight: bold; width: 100%; padding: 0.8rem; }
    </style>
</head>
<body>

    <div class="login-card text-center">
        <h2 class="mb-4" style="color: #00d2ff;">Clínica Dental</h2>
        <form id="formAcceso">
            <div class="text-start mb-2 small text-secondary">USUARIO</div>
            <input type="text" id="userInput" class="form-control mb-3" placeholder="admin / dentista1" required>
            
            <div class="text-start mb-2 small text-secondary">CONTRASEÑA</div>
            <input type="password" id="passInput" class="form-control mb-4" placeholder="1234" required>
            
            <button type="submit" class="btn btn-primary shadow">INGRESAR AL PANEL</button>
        </form>
    </div>

    <script>
        document.getElementById('formAcceso').addEventListener('submit', async (e) => {
            e.preventDefault();

            // CAPTURAMOS LOS VALORES
            const nombre_usuario = document.getElementById('userInput').value;
            const password = document.getElementById('passInput').value;

            try {
                const response = await fetch('/api/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    // CAMBIO CLAVE: Enviamos "nombre_usuario" para que el controlador lo entienda
                    body: JSON.stringify({ nombre_usuario, password })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    // PUNTO 4: GUARDAMOS EL TOKEN (Indispensable para el resto de la app)
                    localStorage.setItem('token', data.token);
                    localStorage.setItem('usuario_nombre', data.usuario.nombre);
                    localStorage.setItem('usuario_rol', data.usuario.rol); 
                    
                    window.location.href = '/agenda';
                } else {
                    alert("Error: " + (data.message || "Credenciales incorrectas"));
                }
            } catch (error) {
                console.error(error);
                alert("Error al conectar con el servidor.");
            }
        });
    </script>
</body>
</html>